{
  "name": "pocketmonitor",
  "productName": "PocketMonitor",
  "version": "1.0.0",
  "description": "Personal laptop monitoring agent: pair once with your phone, see status, apps, browser activity, analytics and a live screen.",
  "main": "src/main.js",
  "author": "PocketMonitor",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "headless": "node src/headless.js",
    "dist": "electron-builder --win nsis",
    "test": "node ../test/e2e.js"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.pocketmonitor.agent",
    "productName": "PocketMonitor",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../extension",
        "to": "extension"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}

# Required for live data — free key at https://serpapi.com/users/sign_up (250 searches / month)
SERPAPI_API_KEY=

# Optional: Claude writes the field report and translates queries for the language lens
ANTHROPIC_API_KEY=

# Optional tuning
# PARALLAX_MODEL=claude-opus-5-5

# Required for live data — free key at https://serpapi.com/users/sign_up (250 searches / month)
SERPAPI_API_KEY=

# Set to 1 only if a proxy attaches the SerpApi key for you (leave SERPAPI_API_KEY empty then)
# SERPAPI_KEY_VIA_PROXY=1

# Optional tuning
# PARALLAX_CACHE_TTL=21600      # seconds to reuse a cached SerpApi response
# PARALLAX_CONCURRENCY=6        # parallel SerpApi requests
# PARALLAX_RECORD=1             # also save responses to backend/fixtures for offline demos
